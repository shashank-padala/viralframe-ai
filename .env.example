# Supabase project settings — find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Pipeline runner only (scripts/pipeline/, run via GitHub Actions) ---
# Never expose these to the browser — no NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DEEPGRAM_API_KEY=your-deepgram-key
OPENAI_API_KEY=your-openai-key
FAL_KEY=your-fal-key

# --- App server only, used to dispatch the pipeline workflow ---
# Fine-grained PAT scoped to just this repo, "Actions: Read and write" only --
# not a classic PAT, not org-wide, no Contents/Administration access.
GITHUB_ACTIONS_TOKEN=your-fine-grained-pat-with-actions-write
